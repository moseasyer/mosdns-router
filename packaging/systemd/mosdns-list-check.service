# The daily list check: mosdns-cdnctl update-lists --check.
#
# It reports whether the China domain list this router reads is still the one the
# reviewed source publishes, and it writes nothing at all. It is not a silent
# update and it is not allowed to become one: nothing here accepts a rules change,
# because an accepted change is a change nobody reviewed. The report is the whole
# output, and an operator applies a change with `update-lists --pin-remote HEAD`
# by hand.
#
# That is why this unit is the shortest of the five. No ReadWritePaths at all,
# because the command takes no lock and writes no file; no UMask, because it
# creates nothing for a umask to apply to; and an empty capability bounding set,
# because it makes two HTTPS requests and needs nothing else. It is still the
# identity that can read the published list, which is why it runs as mosdns-cdn:
# the list and the lock that describes it are mode 0640 root:mosdns.
#
# It is Type=oneshot, it is not enabled, and its timer starts it.

[Unit]
Description=Daily check: has the pinned China domain list moved upstream?
After=network.target

[Service]
Type=oneshot
User=mosdns-cdn
Group=mosdns
ExecStart=/usr/lib/mosdns-router/mosdns-cdnctl update-lists --check
# At most two requests against a 60-second client timeout each, so the 90-second
# default for a oneshot would cut a slow origin off before it could report that it
# was slow.
TimeoutStartSec=180
# No SuccessExitStatus here, and that is the decision rather than an omission.
# This command takes no lock, so the control-lock exit the other two units excuse
# is unreachable, and its exit 3 is a run that produced no report at all --
# including the documented transient, a check that caught a publication in flight.
# The job of this unit is its report, and a daily report-only job that failed is
# information rather than noise: an operator sees one failed day and asks why,
# which is the outcome the check exists to produce.
CapabilityBoundingSet=

# The same sandbox as the other four. This command reads two documents under /etc
# and two under the state directories, makes HTTPS requests, and holds no lock for
# longer than a request takes. It uses no temporary file, no device, no kernel
# setting, no process list and no namespace, and it changes no identity, no clock
# and no real-time priority.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

# It resolves the repository's host name and reads the CA store under /etc. It
# enumerates no interface and opens no UNIX socket of its own, but the system
# resolver may be one, so AF_UNIX is kept.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
